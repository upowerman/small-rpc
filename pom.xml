<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.upowerman</groupId>
    <artifactId>small-rpc</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Small RPC</name>
    <description>A lightweight, extensible, high-performance Java RPC framework.</description>
    <url>https://github.com/upowerman/small-rpc</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>upowerman</id>
            <name>upowerman</name>
            <url>https://github.com/upowerman</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/upowerman/small-rpc.git</connection>
        <developerConnection>scm:git:git@github.com:upowerman/small-rpc.git</developerConnection>
        <url>https://github.com/upowerman/small-rpc</url>
    </scm>

    <modules>
        <module>rpc-core</module>
        <module>rpc-transport-netty</module>
        <module>rpc-registry-local</module>
        <module>rpc-registry-zookeeper</module>
        <module>rpc-registry-redis</module>
        <module>small-rpc-spring</module>
        <module>small-rpc-spring-boot-starter</module>
        <module>rpc-examples</module>
    </modules>

    <!--
        版本唯一真值：使用 Maven CI Friendly ${revision} 属性，发版只需改一处。
        子模块一律不写依赖版本，由下方 dependencyManagement 提供。
        新增模块时只需在此登记，勿在子模块重复声明 groupId/version/依赖版本。
    -->
    <properties>
        <revision>3.0.0</revision>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>4.13.2</junit.version>
        <!-- 同时用于 slf4j-api 与 slf4j-reload4j（后者不在 spring-boot-dependencies 里） -->
        <slf4j.version>1.7.36</slf4j.version>
        <hessian.version>4.0.66</hessian.version>
        <netty.version>4.1.108.Final</netty.version>
        <spring-boot.version>2.7.18</spring-boot.version>
        <!-- hamcrest-core 锁定版本，理由见 dependencyManagement 中该条目的注释 -->
        <hamcrest.version>1.3</hamcrest.version>
        <!-- P3 注册中心模块使用 -->
        <curator.version>5.6.0</curator.version>
        <jedis.version>4.4.3</jedis.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块：版本跟随 reactor -->
            <dependency>
                <groupId>io.github.upowerman</groupId>
                <artifactId>rpc-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upowerman</groupId>
                <artifactId>rpc-transport-netty</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upowerman</groupId>
                <artifactId>rpc-registry-local</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upowerman</groupId>
                <artifactId>rpc-registry-zookeeper</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upowerman</groupId>
                <artifactId>rpc-registry-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upowerman</groupId>
                <artifactId>small-rpc-spring</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upowerman</groupId>
                <artifactId>small-rpc-spring-boot-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.upowerman</groupId>
                <artifactId>rpc-example-api</artifactId>
                <version>${revision}</version>
            </dependency>

            <!--
                三方依赖：本 POM 自己的条目优先于下方 import 进来的 BOM，
                因此显式登记的版本不会被 spring-boot-dependencies 覆盖。
            -->
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <!-- slf4j-reload4j 未被 spring-boot-dependencies 管理（该 BOM 只到 slf4j-log4j12），必须显式登记 -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-reload4j</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <!--
                hamcrest-core：junit 4.13.2 的传递依赖。spring-boot-dependencies 把它管理成 2.2，
                而 2.2 是只含一个弃用提示类的空壳 jar（1.3 有 45 个类；真类在 org.hamcrest:hamcrest 里），
                等于顺带把五个非 spring-boot 模块的测试栈从 Hamcrest 1.3 抬到 2.2。
                这里锁回 junit 4.13.2 自带的 1.3，保持改造前后解析结果一致。
                注意：删掉本条目测试仍会全绿（真类经 hamcrest 2.2 传递到达），
                它保的是"依赖树逐字节等价"，不是测试通过——动它前先想清楚这一点。
            -->
            <dependency>
                <groupId>org.hamcrest</groupId>
                <artifactId>hamcrest-core</artifactId>
                <version>${hamcrest.version}</version>
            </dependency>
            <dependency>
                <groupId>com.caucho</groupId>
                <artifactId>hessian</artifactId>
                <version>${hessian.version}</version>
            </dependency>

            <!--
                netty-bom：spring-boot-dependencies 内部 import 的是 netty-bom 4.1.101.Final，
                会把它覆盖范围内的 netty-* 依赖拉到 4.1.101.Final。这里按 ${netty.version} 显式 import
                同一份 netty-bom，保证全部 netty-*（含 netty-all，BOM 里没有 netty-all 条目）
                停在 4.1.108.Final。

                ⚠ 顺序敏感：本条目必须排在下方 spring-boot-dependencies <b>之前</b>。
                Maven 在同一 dependencyManagement 中导入多个 BOM 时采用“First-Declared Wins”（先声明者优先）
                仲裁规则，若顺序颠倒，后声明的 netty-bom 会被前者覆盖，27 个 netty-* 传递依赖会静默掉回
                4.1.101.Final，且**构建期无任何报错**。调整本段顺序前先读此注释。
            -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- P3 注册中心模块使用 -->
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-framework</artifactId>
                <version>${curator.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-recipes</artifactId>
                <version>${curator.version}</version>
            </dependency>
            <dependency>
                <groupId>redis.clients</groupId>
                <artifactId>jedis</artifactId>
                <version>${jedis.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <!--
            flatten-maven-plugin：配合 ${revision} CI Friendly Versions 使用。
            发布到 Central 时将 pom 中的 ${revision} 替换为实际版本值，
            确保消费方拿到的 pom 里没有未解析的属性占位符。
            放在全局 build（而非 release profile）中，保证本地 install 也能正确解析。
        -->
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.8.0</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <!--
                                只等到 Central 校验通过（VALIDATED）就返回，不再空等
                                PUBLISHED 阶段（实测约十几分钟）。
                                插件只接受 UPLOADED / VALIDATED / PUBLISHED 三个值，
                                没有 PUBLISHING 这个选项。
                            -->
                            <waitUntil>VALIDATED</waitUntil>
                            <excludeArtifacts>
                                <excludeArtifact>rpc-examples</excludeArtifact>
                                <excludeArtifact>rpc-example-api</excludeArtifact>
                                <excludeArtifact>rpc-example-client</excludeArtifact>
                                <excludeArtifact>rpc-example-server</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                        清理 central-staging 里的 Maven 本地仓库元数据。

                        某些 Maven 版本在向 staging 仓库 install 时，会顺带写入
                        _remote.repositories 与 maven-metadata-local.xml。后者落在
                        <group>/<artifact>/ 这一层（没有版本目录、也没有 .pom），
                        Central 的发布校验会判定：
                          "Bundle has content that does NOT have a .pom file"
                        并拒收整个 bundle。

                        绑定到 install 阶段：多模块按顺序构建，最后一个模块的 install
                        一定在它自己的 deploy（打包+上传）之前执行，因此这里是
                        清除干净后才组包的最后时机。
                        用 ${maven.multiModuleProjectDirectory} 指向根目录的 staging。
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <version>3.3.2</version>
                        <executions>
                            <execution>
                                <id>clean-central-staging-metadata</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${maven.multiModuleProjectDirectory}/target/central-staging</directory>
                                            <includes>
                                                <include>**/_remote.repositories*</include>
                                                <include>**/maven-metadata-local.xml*</include>
                                            </includes>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
